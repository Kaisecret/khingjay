{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "khingjay.vercel.app" }],
      "destination": "https://www.khingjay.tech/$1",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/htmlfiles/index.html", "destination": "/", "permanent": true },
    { "source": "/experience.html", "destination": "/experience", "permanent": true },
    { "source": "/htmlfiles/experience.html", "destination": "/experience", "permanent": true },
    { "source": "/tech-stack.html", "destination": "/tech-stack", "permanent": true },
    { "source": "/htmlfiles/tech-stack.html", "destination": "/tech-stack", "permanent": true },
    { "source": "/project.html", "destination": "/project", "permanent": true },
    { "source": "/htmlfiles/project.html", "destination": "/project", "permanent": true },
    { "source": "/case-study.html", "destination": "/case-study", "permanent": true },
    { "source": "/htmlfiles/case-study.html", "destination": "/case-study", "permanent": true }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(images|gallery|award|CERTIFICATE|animationimages)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/htmlfiles/index.html" },
    { "source": "/experience", "destination": "/htmlfiles/experience.html" },
    { "source": "/tech-stack", "destination": "/htmlfiles/tech-stack.html" },
    { "source": "/project", "destination": "/htmlfiles/project.html" },
    { "source": "/case-study", "destination": "/htmlfiles/case-study.html" },
    { "source": "/api/send-email", "destination": "/api/send-email.php" },
    { "source": "/api/chatbot", "destination": "/api/chatbot.php" }
  ]
}